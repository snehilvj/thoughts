<div class="flying-creatures" aria-hidden="true">
  <!-- Bird silhouettes (light mode) -->
  <svg class="creature bird bird--1" viewBox="0 0 20 8" fill="none">
    <path d="M0 8 Q5 0 10 4 Q15 0 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
  </svg>
  <svg class="creature bird bird--2" viewBox="0 0 20 8" fill="none">
    <path d="M0 8 Q5 0 10 4 Q15 0 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
  </svg>
  <svg class="creature bird bird--3" viewBox="0 0 20 8" fill="none">
    <path d="M0 8 Q5 0 10 4 Q15 0 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
  </svg>

  <!-- Bat silhouettes (dark mode) -->
  <svg class="creature bat bat--1" viewBox="0 0 24 10" fill="none">
    <path d="M0 2 Q3 0 6 3 Q8 1 12 5 Q16 1 18 3 Q21 0 24 2 L20 6 Q16 4 12 7 Q8 4 4 6 Z" fill="currentColor"/>
  </svg>
  <svg class="creature bat bat--2" viewBox="0 0 24 10" fill="none">
    <path d="M0 2 Q3 0 6 3 Q8 1 12 5 Q16 1 18 3 Q21 0 24 2 L20 6 Q16 4 12 7 Q8 4 4 6 Z" fill="currentColor"/>
  </svg>
  <svg class="creature bat bat--3" viewBox="0 0 24 10" fill="none">
    <path d="M0 2 Q3 0 6 3 Q8 1 12 5 Q16 1 18 3 Q21 0 24 2 L20 6 Q16 4 12 7 Q8 4 4 6 Z" fill="currentColor"/>
  </svg>
</div>

<style>
  .flying-creatures {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .creature {
    position: absolute;
    color: var(--color-text-muted);
    opacity: 0;
  }

  /* --- Theme visibility --- */
  .bird { display: block; }
  .bat { display: none; }

  :global(:root:not([data-theme='light'])) .bird { display: none; }
  :global(:root:not([data-theme='light'])) .bat { display: block; }

  /* --- Bird sizes & positions --- */
  .bird--1 { width: 18px; top: 12%; }
  .bird--2 { width: 14px; top: 18%; }
  .bird--3 { width: 16px; top: 8%; }

  .bat--1 { width: 20px; top: 10%; }
  .bat--2 { width: 16px; top: 16%; }
  .bat--3 { width: 18px; top: 6%; }

  /* --- Flight animations --- */
  .bird--1, .bat--1 {
    animation: fly-across-1 80s linear 10s infinite;
  }
  .bird--2, .bat--2 {
    animation: fly-across-2 95s linear 40s infinite;
  }
  .bird--3, .bat--3 {
    animation: fly-across-3 70s linear 65s infinite;
  }

  /*
   * Each keyframe keeps the creature off-screen for most of the cycle.
   * The visible flight is ~12-15% of the total duration.
   */
  @keyframes fly-across-1 {
    0%, 5% { transform: translate(-30px, 0); opacity: 0; }
    6% { opacity: 0.2; }
    8% { transform: translate(15vw, -8px); }
    11% { transform: translate(40vw, 4px); }
    14% { transform: translate(65vw, -6px); }
    17% { transform: translate(90vw, 2px); }
    18% { transform: translate(105vw, -3px); opacity: 0.2; }
    19% { opacity: 0; }
    19.1%, 100% { transform: translate(110vw, 0); opacity: 0; }
  }

  @keyframes fly-across-2 {
    0%, 3% { transform: translate(calc(100vw + 30px), 0); opacity: 0; }
    4% { opacity: 0.18; }
    6% { transform: translate(80vw, -6px); }
    9% { transform: translate(55vw, 5px); }
    12% { transform: translate(30vw, -4px); }
    15% { transform: translate(5vw, 3px); }
    16% { transform: translate(-30px, -2px); opacity: 0.18; }
    17% { opacity: 0; }
    17.1%, 100% { transform: translate(-40px, 0); opacity: 0; }
  }

  @keyframes fly-across-3 {
    0%, 8% { transform: translate(-30px, 0); opacity: 0; }
    9% { opacity: 0.15; }
    11% { transform: translate(20vw, 6px); }
    14% { transform: translate(50vw, -5px); }
    17% { transform: translate(75vw, 3px); }
    19% { transform: translate(105vw, -2px); opacity: 0.15; }
    20% { opacity: 0; }
    20.1%, 100% { transform: translate(110vw, 0); opacity: 0; }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .creature {
      animation: none !important;
      display: none !important;
    }
  }
</style>
