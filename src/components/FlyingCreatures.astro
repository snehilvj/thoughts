<style>
  .flying-creatures {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  /* --- Canvas background --- */
  .canvas-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #87CEEB 0%, #B0E0E6 40%, #E0F0FF 100%);
    transition: background var(--transition-slow, 300ms ease-out);
  }

  :global(:root:not([data-theme='light'])) .canvas-bg {
    background: linear-gradient(180deg, #0a0e1a 0%, #111827 40%, #1a1a2e 100%);
  }

  /* --- Theme visibility --- */
  .bird { display: block; }
  .bat { display: none; }
  :global(:root:not([data-theme='light'])) .bird { display: none; }
  :global(:root:not([data-theme='light'])) .bat { display: block; }

  /* --- Creature base --- */
  .creature {
    position: absolute;
    color: var(--color-text-muted);
    opacity: 0;
    width: 44px;
    translate: var(--ox, 0px) var(--oy, 0px);
  }

  .bird { color: #3a3a3a; }
  :global(:root:not([data-theme='light'])) .bat { color: #c0c0c0; }

  /* --- Wing flapping --- */
  .wing {
    transform-origin: 50% 100%;
    animation: flap 0.35s ease-in-out infinite alternate;
    animation-delay: var(--fd, 0s);
  }

  .wing--left { transform-origin: 100% 100%; }
  .wing--right { transform-origin: 0% 100%; }

  @keyframes flap {
    0% { transform: scaleY(1); }
    100% { transform: scaleY(0.25); }
  }

  /* Bats flap faster */
  .bat .wing {
    animation-duration: 0.25s;
  }

  /* --- Flock positioning & flight --- */
  .flock {
    position: absolute;
    opacity: 0;
  }

  .flock--1 { top: 18%; }
  .flock--2 { top: 38%; }
  .flock--3 { top: 58%; }
  .flock--4 { top: 12%; }

  .flock--1 .creature { width: 44px; }
  .flock--2 .creature { width: 38px; }
  .flock--3 .creature { width: 48px; }
  .flock--4 .creature { width: 36px; }

  /* --- Vertical bobbing (on inner wrapper) --- */
  .flock-bob {
    position: relative;
    animation: bob 3s ease-in-out infinite;
  }

  .flock--2 .flock-bob { animation-duration: 3.5s; }
  .flock--3 .flock-bob { animation-duration: 2.8s; }
  .flock--4 .flock-bob { animation-duration: 3.2s; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-18px); }
  }

  /* --- Flight paths --- */
  .flock--1 {
    animation: fly-right 28s linear 2s infinite;
  }
  .flock--2 {
    animation: fly-left 32s linear 10s infinite;
  }
  .flock--3 {
    animation: fly-right 25s linear 18s infinite;
  }
  .flock--4 {
    animation: fly-left 35s linear 6s infinite;
  }

  @keyframes fly-right {
    0%, 2% { transform: translateX(-80px); opacity: 0; }
    4% { opacity: 0.5; }
    6% { transform: translateX(5vw); }
    15% { transform: translateX(25vw); }
    25% { transform: translateX(45vw); }
    35% { transform: translateX(65vw); }
    40% { transform: translateX(80vw); }
    43% { transform: translateX(95vw); opacity: 0.5; }
    45% { transform: translateX(110vw); opacity: 0; }
    45.1%, 100% { transform: translateX(110vw); opacity: 0; }
  }

  @keyframes fly-left {
    0%, 2% { transform: translateX(calc(100vw + 80px)); opacity: 0; }
    4% { opacity: 0.45; }
    6% { transform: translateX(90vw); }
    15% { transform: translateX(70vw); }
    25% { transform: translateX(50vw); }
    35% { transform: translateX(30vw); }
    40% { transform: translateX(15vw); }
    43% { transform: translateX(-40px); opacity: 0.45; }
    45% { transform: translateX(-100px); opacity: 0; }
    45.1%, 100% { transform: translateX(-100px); opacity: 0; }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .flock,
    .flock-bob,
    .wing {
      animation: none !important;
    }
    .flock {
      display: none !important;
    }
  }
</style>
