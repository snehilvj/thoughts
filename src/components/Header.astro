---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  path?: string;
}

const { path = '~' } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

<header class="header">
  <nav class="header__nav container container--wide">
    <div class="header__left">
      <a href={base} class="header__path">{path}</a>
      <span class="header__prompt">$</span>
    </div>

    <div class="header__links">
      <a href={`${base}blog`} class:list={['header__link', { active: pathname.startsWith(`${base}blog`) }]}>[blog]</a>
      <a href={`${base}about`} class:list={['header__link', { active: pathname.startsWith(`${base}about`) }]}>[about]</a>
      <a href={`${base}rss.xml`} class="header__link">[rss]</a>
    </div>

    <div class="header__actions">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header__path {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .header__path:hover {
    color: var(--color-accent);
  }

  .header__prompt {
    color: var(--color-accent);
    font-size: 0.85rem;
  }

  .header__links {
    display: flex;
    gap: 1rem;
  }

  .header__link {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .header__link:hover,
  .header__link.active {
    color: var(--color-accent);
  }

  .header__actions {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .header__links {
      gap: 0.75rem;
    }

    .header__path,
    .header__prompt,
    .header__link {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .header__nav {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .header__links {
      order: 3;
      width: 100%;
    }
  }
</style>
