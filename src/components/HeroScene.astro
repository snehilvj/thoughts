---
---

<div class="hero-scene" id="hero-scene">
  <canvas id="hero-canvas"></canvas>
  <div class="hero-scene__overlay">
    <slot />
  </div>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const container = document.getElementById('hero-scene') as HTMLDivElement;

  if (canvas && container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.z = 4;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);

    // Icosahedron with organic displacement
    const geometry = new THREE.IcosahedronGeometry(1.5, 4);
    const positionAttr = geometry.getAttribute('position');
    const originalPositions = new Float32Array(positionAttr.array);

    // Wireframe material
    const wireframeMat = new THREE.MeshBasicMaterial({
      color: new THREE.Color('#818cf8'),
      wireframe: true,
      transparent: true,
      opacity: 0.35,
    });

    const wireframeMesh = new THREE.Mesh(geometry, wireframeMat);

    const group = new THREE.Group();
    group.add(wireframeMesh);
    scene.add(group);

    // Floating particles
    const particleCount = 80;
    const particleGeom = new THREE.BufferGeometry();
    const particlePositions = new Float32Array(particleCount * 3);
    for (let i = 0; i < particleCount * 3; i++) {
      particlePositions[i] = (Math.random() - 0.5) * 8;
    }
    particleGeom.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    const particleMat = new THREE.PointsMaterial({
      color: 0x818cf8,
      size: 0.02,
      transparent: true,
      opacity: 0.6,
    });
    const particles = new THREE.Points(particleGeom, particleMat);
    scene.add(particles);

    // Mouse tracking
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    document.addEventListener('mousemove', (e) => {
      mouseX = (e.clientX / window.innerWidth) * 2 - 1;
      mouseY = (e.clientY / window.innerHeight) * 2 - 1;
    });

    // Simple 3D noise approximation
    function noise3D(x: number, y: number, z: number): number {
      const n = Math.sin(x * 1.5 + y * 2.3 + z * 0.7) *
                Math.cos(y * 1.8 + z * 2.1 + x * 0.9) *
                Math.sin(z * 1.2 + x * 1.7 + y * 0.5);
      return n;
    }

    // Animation
    function animate() {
      requestAnimationFrame(animate);

      const time = performance.now() * 0.001;

      // Smooth mouse follow
      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      // Rotate group based on mouse
      group.rotation.y = targetX * 0.5 + time * 0.15;
      group.rotation.x = -targetY * 0.3 + Math.sin(time * 0.2) * 0.1;

      // Vertex displacement
      const positions = positionAttr.array as Float32Array;
      for (let i = 0; i < positions.length; i += 3) {
        const ox = originalPositions[i];
        const oy = originalPositions[i + 1];
        const oz = originalPositions[i + 2];

        const displacement = noise3D(
          ox + time * 0.3,
          oy + time * 0.2,
          oz + time * 0.4
        ) * 0.15;

        const len = Math.sqrt(ox * ox + oy * oy + oz * oz);
        positions[i] = ox + (ox / len) * displacement;
        positions[i + 1] = oy + (oy / len) * displacement;
        positions[i + 2] = oz + (oz / len) * displacement;
      }
      positionAttr.needsUpdate = true;

      // Particles slow drift
      particles.rotation.y = time * 0.02;
      particles.rotation.x = time * 0.01;

      renderer.render(scene, camera);
    }

    animate();

    // Resize handler — debounced and only on real width changes
    // to prevent mobile scroll-triggered viewport resizes from causing zoom
    let lastWidth = container.clientWidth;
    let resizeTimer: ReturnType<typeof setTimeout>;

    function onResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const w = container.clientWidth;
        // Only resize if width actually changed (ignore mobile address bar hide/show)
        if (Math.abs(w - lastWidth) < 2) return;
        lastWidth = w;
        const h = container.clientHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }, 100);
    }

    window.addEventListener('resize', onResize);

    // Theme-aware colors
    const observer = new MutationObserver(() => {
      const isLight = document.documentElement.dataset.theme === 'light';
      wireframeMat.color.set(isLight ? '#6366f1' : '#818cf8');
      wireframeMat.opacity = isLight ? 0.3 : 0.35;
      particleMat.color.set(isLight ? '#6366f1' : '#818cf8');
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>

<style>
  .hero-scene {
    position: relative;
    width: 100%;
    height: 85vh;
    min-height: 500px;
    max-height: 800px;
    overflow: hidden;
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-scene__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    text-align: center;
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .hero-scene {
      height: 70vh;
      min-height: 400px;
    }
  }
</style>
