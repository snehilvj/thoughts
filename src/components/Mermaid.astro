---
// Client-side mermaid rendering. Loads mermaid from CDN and renders
// code blocks with data-language="mermaid" as diagrams.
---

<script>
  async function initMermaid() {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    if (blocks.length === 0) return;

    // @ts-ignore - loaded from CDN
    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

    const isDark = document.documentElement.dataset.theme !== 'light';

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      fontFamily: 'JetBrains Mono, monospace',
      fontSize: 14,
      darkMode: isDark,
      themeVariables: isDark ? {
        primaryColor: '#2a2520',
        primaryTextColor: '#e0ddd5',
        primaryBorderColor: '#e2a052',
        lineColor: '#5c5a56',
        secondaryColor: '#1e1e1e',
        tertiaryColor: '#242424',
        noteTextColor: '#e0ddd5',
        noteBkgColor: '#1e1e1e',
        noteBorderColor: '#e2a052',
      } : {
        primaryColor: '#f0ede8',
        primaryTextColor: '#2c2a26',
        primaryBorderColor: '#b87d30',
        lineColor: '#a8a49c',
        secondaryColor: '#faf8f5',
        tertiaryColor: '#e8e5e0',
      },
    });

    for (let i = 0; i < blocks.length; i++) {
      const block = blocks[i] as HTMLElement;
      const code = block.querySelector('code')?.textContent?.trim();
      if (!code) continue;

      const container = document.createElement('div');
      container.className = 'mermaid-diagram';

      try {
        const { svg } = await mermaid.render(`mermaid-${i}`, code);
        container.innerHTML = svg;
        block.replaceWith(container);
      } catch (e) {
        console.warn('Mermaid render error:', e);
      }
    }
  }

  initMermaid();
</script>

<style is:global>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    margin: 1.5em 0;
    padding: var(--space-5);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }
</style>
