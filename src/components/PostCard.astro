---
import TagList from './TagList.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  body: string;
}

const { title, description, pubDate, tags, slug, body } = Astro.props;
const readingTime = getReadingTime(body);
const base = import.meta.env.BASE_URL;
const dateStr = pubDate.toISOString().split('T')[0];
---

<article class="post-card" data-tags={tags.join(',')}>
  <a href={`${base}blog/${slug}`} class="post-card__link">
    <div class="post-card__header">
      <h3 class="post-card__title">{title}</h3>
      <span class="post-card__time">{readingTime}</span>
    </div>
    <p class="post-card__desc">{description}</p>
  </a>
  <div class="post-card__meta">
    <span class="post-card__date">{dateStr}</span>
    {tags.length > 0 && (
      <>
        <span class="post-card__sep">·</span>
        <TagList tags={tags} />
      </>
    )}
  </div>
</article>

<style>
  .post-card {
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-separator);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    transition: color var(--transition-fast);
  }

  .post-card__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .post-card__title {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text);
    transition: color var(--transition-fast);
    line-height: 1.4;
  }

  .post-card__link:hover .post-card__title {
    color: var(--color-accent);
  }

  .post-card__time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .post-card__desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: var(--space-2);
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-card__sep {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .post-card__header {
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
