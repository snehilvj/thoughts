---
import TagList from './TagList.astro';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  body: string;
}

const { title, description, pubDate, tags, slug, body } = Astro.props;
const readingTime = getReadingTime(body);
const base = import.meta.env.BASE_URL;
const dateStr = pubDate.toISOString().split('T')[0];
---

<article class="post-entry" data-tags={tags.join(',')}>
  <div class="post-entry__row">
    <span class="post-entry__date">{dateStr}</span>
    <span class="post-entry__time">{readingTime}</span>
    <a href={`${base}blog/${slug}`} class="post-entry__title">{title}</a>
  </div>
  <div class="post-entry__details">
    <p class="post-entry__desc">{description}</p>
    {tags.length > 0 && <TagList tags={tags} />}
  </div>
</article>

<style>
  .post-entry {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-entry:last-child {
    border-bottom: none;
  }

  .post-entry__row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .post-entry__date {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .post-entry__time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .post-entry__title {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .post-entry__title:hover {
    color: var(--color-accent);
  }

  .post-entry__details {
    margin-top: 0.4rem;
  }

  .post-entry__desc {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  @media (max-width: 768px) {
    .post-entry__row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
