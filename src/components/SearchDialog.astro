---
---

<dialog class="search-dialog" id="search-dialog">
  <div class="search-dialog__backdrop"></div>
  <div class="search-dialog__content">
    <div class="search-dialog__input-wrap">
      <svg class="search-dialog__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        class="search-dialog__input"
        id="search-input"
        placeholder="Search posts..."
        autocomplete="off"
      />
      <kbd class="search-dialog__kbd">Esc</kbd>
    </div>
    <div class="search-dialog__results" id="search-results"></div>
  </div>
</dialog>

<script>
  let searchIndex: Array<{
    title: string;
    description: string;
    slug: string;
    tags: string[];
  }> | null = null;

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLDivElement;
  const searchBtn = document.querySelector('.header__search-btn');

  async function loadIndex() {
    if (searchIndex) return searchIndex;
    const res = await fetch('/search.json');
    searchIndex = await res.json();
    return searchIndex;
  }

  function openSearch() {
    dialog.showModal();
    input.focus();
    input.value = '';
    results.innerHTML = '';
  }

  function closeSearch() {
    dialog.close();
  }

  function renderResults(query: string, data: typeof searchIndex) {
    if (!data || !query.trim()) {
      results.innerHTML = query.trim()
        ? '<p class="search-dialog__empty">No results found.</p>'
        : '';
      return;
    }

    const q = query.toLowerCase();
    const matches = data.filter(
      (item) =>
        item.title.toLowerCase().includes(q) ||
        item.description.toLowerCase().includes(q) ||
        item.tags.some((t) => t.toLowerCase().includes(q))
    );

    if (matches.length === 0) {
      results.innerHTML = '<p class="search-dialog__empty">No results found.</p>';
      return;
    }

    results.innerHTML = matches
      .map(
        (item) => `
        <a href="/blog/${item.slug}" class="search-dialog__result">
          <span class="search-dialog__result-title">${item.title}</span>
          <span class="search-dialog__result-desc">${item.description}</span>
        </a>
      `
      )
      .join('');
  }

  // Event listeners
  searchBtn?.addEventListener('click', openSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  dialog?.addEventListener('click', (e) => {
    if ((e.target as Element).classList.contains('search-dialog__backdrop')) {
      closeSearch();
    }
  });

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', async () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(async () => {
      const data = await loadIndex();
      renderResults(input.value, data);
    }, 150);
  });
</script>

<style>
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 200;
    border: none;
    background: none;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }

  .search-dialog::backdrop {
    display: none;
  }

  .search-dialog__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .search-dialog__content {
    position: relative;
    max-width: 560px;
    margin: 15vh auto 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .search-dialog__input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-dialog__icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-dialog__input {
    flex: 1;
    border: none;
    background: none;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    outline: none;
  }

  .search-dialog__input::placeholder {
    color: var(--color-text-muted);
  }

  .search-dialog__kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15em 0.5em;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  .search-dialog__results {
    max-height: 50vh;
    overflow-y: auto;
  }

  .search-dialog__result {
    display: block;
    padding: 0.75rem 1rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background var(--transition-fast);
  }

  .search-dialog__result:hover {
    background: var(--color-bg-secondary);
  }

  .search-dialog__result:last-child {
    border-bottom: none;
  }

  .search-dialog__result-title {
    display: block;
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 0.2rem;
  }

  .search-dialog__result-desc {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .search-dialog__empty {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
