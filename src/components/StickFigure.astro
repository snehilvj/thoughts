---

<canvas id="stick-figure-canvas" aria-hidden="true"></canvas>

<script>
  import { init } from '../scripts/stick-figure/index';

  let cleanup: (() => void) | null = null;

  function start() {
    const canvas = document.getElementById('stick-figure-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    cleanup?.();
    cleanup = init(canvas);
  }

  // Support Astro page transitions
  document.addEventListener('astro:page-load', start);

  // Fallback for initial load without view transitions
  if (!document.querySelector('[name="astro-view-transitions"]')) {
    start();
  }
</script>

<style>
  #stick-figure-canvas {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 50;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    #stick-figure-canvas {
      bottom: 8px;
      right: 8px;
    }
  }
</style>
