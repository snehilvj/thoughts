---
interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="tag-list">
  {tags.map((tag, i) => (
    <>
      {i > 0 && <span class="tag-sep">·</span>}
      {linked ? (
        <a href={`${base}tags/${tag}`} class="tag">{tag}</a>
      ) : (
        <span class="tag">{tag}</span>
      )}
    </>
  ))}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .tag-sep {
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }
</style>
