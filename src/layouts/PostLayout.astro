---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { getReadingTime } from '../utils/readingTime';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
  heroAlt?: string;
  body: string;
}

const { title, description, pubDate, updatedDate, tags = [], heroImage, heroAlt, body } = Astro.props;
const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const dateStr = pubDate.toISOString().split('T')[0];
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
  <article class="post container">
    <header class="post__header">
      <h1 class="post__title"># {title}</h1>
      <p class="post__meta">posted: {dateStr} · {readingTime}</p>
      {tags.length > 0 && (
        <div class="post__tags">
          <TagList tags={tags} />
        </div>
      )}
    </header>

    <hr class="post__separator" />

    {heroImage && (
      <img
        class="post__hero"
        src={heroImage}
        alt={heroAlt || title}
        loading="eager"
      />
    )}

    <div class="prose">
      <slot />
    </div>

    {updatedDate && (
      <p class="post__updated">
        updated: {updatedDate.toISOString().split('T')[0]}
      </p>
    )}
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
      },
      url: canonicalUrl,
      ...(heroImage ? { image: new URL(heroImage, SITE.url).href } : {}),
    })}
  />
</BaseLayout>

<style>
  .post {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .post__header {
    margin-bottom: 0;
  }

  .post__title {
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .post__meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .post__tags {
    margin-bottom: 0;
  }

  .post__separator {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 1.5rem 0 2rem;
  }

  .post__hero {
    width: 100%;
    margin-bottom: 2rem;
  }

  .post__updated {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.3rem;
    }
  }
</style>
