---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { getReadingTime } from '../utils/readingTime';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
  heroAlt?: string;
  body: string;
}

const { title, description, pubDate, updatedDate, tags = [], heroImage, heroAlt, body } = Astro.props;
const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
  <article class="post container">
    <header class="post__header">
      <div class="post__meta">
        <FormattedDate date={pubDate} />
        <span class="post__meta-sep">&middot;</span>
        <span class="post__reading-time">{readingTime}</span>
      </div>
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      {tags.length > 0 && <TagList tags={tags} />}
    </header>

    {heroImage && (
      <img
        class="post__hero"
        src={heroImage}
        alt={heroAlt || title}
        loading="eager"
      />
    )}

    <div class="prose">
      <slot />
    </div>

    {updatedDate && (
      <p class="post__updated">
        Last updated on <FormattedDate date={updatedDate} />
      </p>
    )}
  </article>

  <!-- JSON-LD Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
      },
      url: canonicalUrl,
      ...(heroImage ? { image: new URL(heroImage, SITE.url).href } : {}),
    })}
  />
</BaseLayout>

<style>
  .post {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .post__header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .post__meta-sep {
    color: var(--color-border);
  }

  .post__title {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .post__description {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post__hero {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }

  .post__updated {
    margin-top: 3rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.8rem;
    }

    .post__description {
      font-size: 1rem;
    }
  }
</style>
