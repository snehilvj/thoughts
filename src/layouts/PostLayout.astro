---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Sources from '../components/Sources.astro';
import { getReadingTime } from '../utils/readingTime';
import { SITE } from '../config';

interface Source {
  title: string;
  description?: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
  heroAlt?: string;
  body: string;
  slug: string;
  sources?: Source[];
}

const { title, description, pubDate, updatedDate, tags = [], heroImage, heroAlt, body, slug, sources = [] } = Astro.props;
const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const dateStr = pubDate.toISOString().split('T')[0];
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
  <article class="post container">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      <div class="post__meta">
        <span>{dateStr}</span>
        <span class="post__meta-sep">·</span>
        <span>{readingTime}</span>
      </div>
      {tags.length > 0 && (
        <div class="post__tags">
          <TagList tags={tags} />
        </div>
      )}
    </header>

    <hr class="post__separator" />

    {heroImage && (
      <img
        class="post__hero"
        src={heroImage}
        alt={heroAlt || title}
        loading="eager"
      />
    )}

    <div class="prose">
      <slot />
    </div>

    {sources.length > 0 && <Sources sources={sources} />}

    {updatedDate && (
      <p class="post__updated">
        Updated {updatedDate.toISOString().split('T')[0]}
      </p>
    )}

    <RelatedPosts currentSlug={slug} currentTags={tags} />
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
      },
      url: canonicalUrl,
      ...(heroImage ? { image: new URL(heroImage, SITE.url).href } : {}),
    })}
  />

  <script>
    function extractDominantColor(img: HTMLImageElement) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      const size = 64;
      canvas.width = size;
      canvas.height = size;

      try {
        ctx.drawImage(img, 0, 0, size, size);
        const data = ctx.getImageData(0, 0, size, size).data;

        let r = 0, g = 0, b = 0, count = 0;
        for (let i = 0; i < data.length; i += 16) {
          const a = data[i + 3];
          if (a < 128) continue;
          r += data[i];
          g += data[i + 1];
          b += data[i + 2];
          count++;
        }

        if (count === 0) return;
        r = Math.round(r / count);
        g = Math.round(g / count);
        b = Math.round(b / count);

        // Boost saturation slightly so the spill feels vibrant
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        if (max - min < 30) {
          // Near-grayscale image — use a warm neutral spill
          img.style.setProperty('--spill-color', `rgba(${r}, ${g}, ${b}, 0.18)`);
        } else {
          img.style.setProperty('--spill-color', `rgba(${r}, ${g}, ${b}, 0.25)`);
        }
      } catch {
        // Cross-origin image, keep CSS fallback
      }
    }

    function processImages() {
      document.querySelectorAll<HTMLImageElement>('.prose img, .post__hero').forEach((img) => {
        if (img.hasAttribute('data-spill')) return;
        img.setAttribute('data-spill', '');
        if (img.complete && img.naturalWidth > 0) {
          extractDominantColor(img);
        } else {
          img.addEventListener('load', () => extractDominantColor(img), { once: true });
        }
      });
    }

    processImages();
    document.addEventListener('astro:page-load', processImages);
    // Also handle lazy-loaded images that enter the DOM later
    if ('MutationObserver' in window) {
      new MutationObserver(processImages).observe(document.body, { childList: true, subtree: true });
    }
  </script>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
  }

  .post__title {
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .post__description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    line-height: 1.6;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }

  .post__meta-sep {
    color: var(--color-text-muted);
  }

  .post__tags {
    margin-top: var(--space-3);
  }

  .post__separator {
    border: none;
    height: 1px;
    background: var(--color-separator);
    margin: var(--space-8) 0;
  }

  .post__hero {
    width: 100%;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    --spill-color: rgba(226, 160, 82, 0.15);
    box-shadow: 0 8px 40px var(--spill-color), 0 2px 12px rgba(0, 0, 0, 0.15);
    transition: box-shadow var(--transition-slow);
  }

  .post__updated {
    margin-top: var(--space-8);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.4rem;
    }
  }
</style>
