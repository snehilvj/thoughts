---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { getReadingTime } from '../utils/readingTime';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: string;
  heroAlt?: string;
  body: string;
}

const { title, description, pubDate, updatedDate, tags = [], heroImage, heroAlt, body } = Astro.props;
const readingTime = getReadingTime(body);
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const dateStr = pubDate.toISOString().split('T')[0];
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
  <article class="post container">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <p class="post__description">{description}</p>
      <div class="post__meta">
        <span>{dateStr}</span>
        <span class="post__meta-sep">·</span>
        <span>{readingTime}</span>
      </div>
      {tags.length > 0 && (
        <div class="post__tags">
          <TagList tags={tags} />
        </div>
      )}
    </header>

    <hr class="post__separator" />

    {heroImage && (
      <img
        class="post__hero"
        src={heroImage}
        alt={heroAlt || title}
        loading="eager"
      />
    )}

    <div class="prose">
      <slot />
    </div>

    {updatedDate && (
      <p class="post__updated">
        Updated {updatedDate.toISOString().split('T')[0]}
      </p>
    )}
  </article>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate || pubDate).toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
      },
      url: canonicalUrl,
      ...(heroImage ? { image: new URL(heroImage, SITE.url).href } : {}),
    })}
  />
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-8);
    padding-bottom: var(--space-10);
  }

  .post__title {
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .post__description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    line-height: 1.6;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: var(--space-4);
  }

  .post__meta-sep {
    color: var(--color-text-muted);
  }

  .post__tags {
    margin-top: var(--space-3);
  }

  .post__separator {
    border: none;
    height: 1px;
    background: var(--color-separator);
    margin: var(--space-8) 0;
  }

  .post__hero {
    width: 100%;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }

  .post__updated {
    margin-top: var(--space-8);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: 1.4rem;
    }
  }
</style>
