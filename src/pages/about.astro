---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="About" description={`About ${SITE.author} — software engineer, startup founder, and writer.`}>
  <div class="about container">
    <h1 class="about__title">About</h1>

    <div class="about__content prose">
      <p>
        Hey, I'm <strong>Snehil Vijay</strong> — a software engineer and startup founder.
        I build things for a living and write about the journey here.
      </p>

      <p>
        This blog is my corner of the internet where I share thoughts on
        software engineering, the startup grind, technology opinions, and
        life beyond the screen — from travel stories to food discoveries.
      </p>

      <h2>What I write about</h2>
      <ul>
        <li><strong>Tech</strong> — deep dives into tools, frameworks, and engineering decisions</li>
        <li><strong>Startup</strong> — lessons from building a company, product thinking, growth</li>
        <li><strong>Opinions</strong> — takes on the industry, developer culture, and trends</li>
        <li><strong>Life</strong> — travel, food, experiences, and everything in between</li>
      </ul>

      <h2>Connect</h2>
      <p>
        Find me on <a href={SITE.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>,
        or subscribe to the <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS feed</a> to stay updated.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding: 3rem 1.5rem 4rem;
  }

  .about__title {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }
</style>
