---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, getAllTags } from '../../utils/posts';

const posts = await getSortedPosts();
const allTags = await getAllTags();
const tagList = Array.from(allTags.keys()).sort();
---

<BaseLayout title="Posts" description="All posts  - tech, opinions, startup life, and more.">
  <div class="blog container">
    <h1 class="blog__title">Posts</h1>

    {tagList.length > 0 && (
      <div class="blog__filter" id="tag-filter">
        <button class="filter-btn active" data-tag="all">all</button>
        {tagList.map((tag) => (
          <button class="filter-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>
    )}

    <div class="blog__posts" id="posts-list">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          body={post.body || ''}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const posts = document.querySelectorAll('.post-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = (btn as HTMLElement).dataset.tag;
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      posts.forEach((post) => {
        const postTags = (post as HTMLElement).dataset.tags?.split(',') || [];
        (post as HTMLElement).style.display =
          tag === 'all' || postTags.includes(tag!) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .blog {
    padding: var(--space-8) var(--space-5) var(--space-10);
  }

  .blog__title {
    font-size: 1.5rem;
    margin-bottom: var(--space-5);
  }

  .blog__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-separator);
    margin-bottom: var(--space-2);
  }

  .filter-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text);
  }

  .filter-btn.active {
    color: var(--color-accent);
  }
</style>
