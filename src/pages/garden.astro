---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/garden.css';
---

<BaseLayout title="Garden" description="Watch an origami cherry blossom tree grow with every visit.">
  <div class="garden container container--wide">
    <!-- Loader (static HTML, visible immediately before JS) -->
    <div id="garden-loader" class="garden-loader">
      <svg viewBox="0 0 60 60" class="garden-loader__icon" aria-hidden="true">
        <polygon points="30,8 52,42 8,42" class="garden-loader__fold" />
        <polygon points="30,8 30,42 8,42" class="garden-loader__fold" style="opacity: 0.7; animation-delay: 0.2s;" />
      </svg>
      <span class="garden-loader__text">unfolding...</span>
    </div>

    <!-- Scene container -->
    <div id="garden-scene-wrapper" class="garden__scene">
      <svg
        id="garden-scene"
        viewBox="0 0 800 600"
        preserveAspectRatio="xMidYMax meet"
        role="img"
        aria-label="An origami cherry blossom tree that grows with each visit"
      >
        <defs>
          <!-- Paper texture filter -->
          <filter id="paper-texture" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" result="noise" />
            <feDiffuseLighting in="noise" lighting-color="white" surfaceScale="0.8" result="light">
              <feDistantLight azimuth="45" elevation="55" />
            </feDiffuseLighting>
            <feComposite in="SourceGraphic" in2="light" operator="arithmetic" k1="0.7" k2="0.3" k3="0" k4="0" />
          </filter>
        </defs>
        <g id="layer-sky"></g>
        <g id="layer-tree"></g>
        <g id="layer-creatures"></g>
        <g id="layer-particles"></g>
        <g id="layer-ground"></g>
      </svg>
    </div>

    <!-- Stats bar -->
    <div id="garden-stats" class="garden__stats">
      <span id="garden-visits"></span>
      <span id="garden-stage"></span>
    </div>
  </div>
</BaseLayout>

<script>
  async function init() {
    const { bootstrap } = await import('../scripts/garden/index');
    bootstrap();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
