---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts } from '../utils/posts';
import { SITE } from '../config';

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <div class="home container">
    <section class="home__hero">
      <h1 class="home__title">{SITE.title}<span class="cursor">_</span></h1>
      <p class="home__tagline">{SITE.tagline}</p>
    </section>

    <section class="home__recent">
      <h2 class="home__section-label">Recent</h2>

      <div class="home__posts">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id}
            body={post.body || ''}
          />
        ))}
      </div>

      {posts.length > 5 && (
        <a href={`${import.meta.env.BASE_URL}blog`} class="home__all">all posts &rarr;</a>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: var(--space-10);
  }

  .home__hero {
    padding: var(--space-10) 0 var(--space-8);
  }

  .home__title {
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .home__tagline {
    color: var(--color-text-secondary);
    font-size: 1rem;
    margin-top: var(--space-3);
    max-width: 28ch;
    line-height: 1.6;
  }

  .home__recent {
    border-top: 1px solid var(--color-separator);
    padding-top: var(--space-6);
  }

  .home__section-label {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .home__all {
    display: inline-block;
    margin-top: var(--space-5);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .home__all:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .home__hero {
      padding: var(--space-8) 0 var(--space-6);
    }

    .home__title {
      font-size: 2rem;
    }
  }
</style>
