---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts } from '../utils/posts';
import { SITE } from '../config';

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <div class="home container">
    <section class="home__hero">
      <h1 class="home__title">{SITE.title}<span class="cursor">_</span></h1>
      <p class="home__tagline">{SITE.tagline}</p>
      <p class="home__author">by {SITE.author}</p>
    </section>

    <section class="home__recent">
      <p class="prompt">cat recent.log</p>

      <div class="home__posts">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id}
            body={post.body || ''}
          />
        ))}
      </div>

      {posts.length > 5 && (
        <a href={`${import.meta.env.BASE_URL}blog`} class="home__all prompt">cd blog/ →</a>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding: 2rem 1.5rem 4rem;
  }

  .home__hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .home__title {
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .home__tagline {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .home__author {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .home__recent {
    margin-top: 1rem;
  }

  .home__all {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .home__all:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .home__hero {
      padding: 2rem 0;
    }

    .home__title {
      font-size: 1.8rem;
    }
  }
</style>
