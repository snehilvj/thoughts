---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts } from '../utils/posts';
import { SITE } from '../config';

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <HeroScene>
    <h1 class="hero__title">{SITE.title}</h1>
    <p class="hero__tagline">{SITE.tagline}</p>
    <p class="hero__author">by {SITE.author}</p>
  </HeroScene>

  <section class="recent container">
    <h2 class="recent__heading">Recent thoughts</h2>
    <div class="recent__posts">
      {recentPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          body={post.body || ''}
        />
      ))}
    </div>
    {posts.length > 5 && (
      <a href={`${import.meta.env.BASE_URL}blog`} class="recent__all">View all posts &rarr;</a>
    )}
  </section>
</BaseLayout>

<style>
  .hero__title {
    font-size: 4rem;
    font-style: italic;
    margin-bottom: 0.5rem;
    letter-spacing: -0.04em;
  }

  .hero__tagline {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
    max-width: 400px;
  }

  .hero__author {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .recent {
    padding: 4rem 1.5rem 2rem;
  }

  .recent__heading {
    font-size: 1.1rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-transform: lowercase;
    font-weight: 400;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  .recent__all {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .recent__all:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .hero__title {
      font-size: 2.5rem;
    }

    .hero__tagline {
      font-size: 1rem;
    }
  }
</style>
