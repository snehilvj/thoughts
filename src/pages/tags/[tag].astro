---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, getAllTags } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = await getAllTags();

  return Array.from(tags.keys()).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${tag}`} description={`Posts tagged "${tag}".`}>
  <div class="tag-page container">
    <div class="tag-page__header">
      <h1 class="tag-page__title">{tag}</h1>
      <span class="tag-page__count">{posts.length} post{posts.length !== 1 ? 's' : ''}</span>
    </div>

    <div class="tag-page__posts">
      {posts.map((post: any) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          body={post.body || ''}
        />
      ))}
    </div>

    <a href={`${base}tags`} class="tag-page__back">&larr; tags</a>
  </div>
</BaseLayout>

<style>
  .tag-page {
    padding: var(--space-8) var(--space-5) var(--space-10);
  }

  .tag-page__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .tag-page__title {
    font-size: 1.5rem;
  }

  .tag-page__count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .tag-page__back {
    display: inline-block;
    margin-top: var(--space-6);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .tag-page__back:hover {
    color: var(--color-accent);
  }
</style>
