---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, getAllTags } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = await getAllTags();

  return Array.from(tags.keys()).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Posts tagged "${tag}"`} description={`All posts tagged with "${tag}".`}>
  <div class="tag-page container">
    <p class="prompt">grep "{tag}" posts/ <span class="tag-page__count">{posts.length} result{posts.length !== 1 ? 's' : ''}</span></p>

    <div class="tag-page__posts">
      {posts.map((post: any) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          slug={post.id}
          body={post.body || ''}
        />
      ))}
    </div>

    <a href={`${base}tags`} class="tag-page__back">&larr; cd ../tags/</a>
  </div>
</BaseLayout>

<style>
  .tag-page {
    padding: 3rem 1.5rem 4rem;
  }

  .tag-page__count {
    color: var(--color-text-muted);
    margin-left: 1rem;
  }

  .tag-page__posts {
    margin-top: 1.5rem;
  }

  .tag-page__back {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.85rem;
    color: var(--color-accent);
  }
</style>
