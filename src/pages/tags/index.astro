---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';

const allTags = await getAllTags();
const sortedTags = Array.from(allTags.entries()).sort((a, b) => b[1] - a[1]);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="tags-page container">
    <p class="prompt">ls tags/</p>

    <div class="tags-page__list">
      {sortedTags.map(([tag, count]) => (
        <a href={`${base}tags/${tag}`} class="tags-page__item">
          [{tag}] <span class="tags-page__count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page {
    padding: 3rem 1.5rem 4rem;
  }

  .tags-page__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .tags-page__item {
    font-size: 0.9rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .tags-page__item:hover {
    color: var(--color-accent);
  }

  .tags-page__count {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
</style>
