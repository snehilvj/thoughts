---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';

const allTags = await getAllTags();
const sortedTags = Array.from(allTags.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="tags-page container">
    <h1 class="tags-page__title">Tags</h1>
    <div class="tags-page__grid">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}`} class="tags-page__item">
          <span class="tags-page__tag">{tag}</span>
          <span class="tags-page__count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page {
    padding: 3rem 1.5rem 4rem;
  }

  .tags-page__title {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .tags-page__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tags-page__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5em 1em;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-fast);
  }

  .tags-page__item:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  .tags-page__tag {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .tags-page__count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    padding: 0.1em 0.5em;
    border-radius: 999px;
  }
</style>
