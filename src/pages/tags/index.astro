---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';

const allTags = await getAllTags();
const sortedTags = Array.from(allTags.entries()).sort((a, b) => b[1] - a[1]);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="tags-page container">
    <h1 class="tags-page__title">Tags</h1>

    <div class="tags-page__list">
      {sortedTags.map(([tag, count]) => (
        <a href={`${base}tags/${tag}`} class="tags-page__item">
          <span class="tags-page__name">{tag}</span>
          <span class="tags-page__count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .tags-page {
    padding: var(--space-8) var(--space-5) var(--space-10);
  }

  .tags-page__title {
    font-size: 1.5rem;
    margin-bottom: var(--space-6);
  }

  .tags-page__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .tags-page__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .tags-page__item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .tags-page__count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
</style>
